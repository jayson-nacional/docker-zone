FROM archlinux:base-devel
ARG CONTAINER_USER

# system update
RUN pacman --noconfirm -Syu

# version control
RUN pacman -S --noconfirm  git 

# multiplexer
RUN pacman -S --noconfirm tmux

# openssh
RUN pacman -S --noconfirm openssh

# zsh
RUN pacman -S --noconfirm zsh \
	zsh-completions

# terminal
RUN pacman -S --noconfirm ncurses
ENV TERM=alacritty

# utilities
RUN pacman -S --noconfirm nodejs \
	npm \
	unzip \
	ripgrep

# neovim
RUN pacman -S --noconfirm neovim

RUN useradd $CONTAINER_USER
USER $CONTAINER_USER

WORKDIR /home/$CONTAINER_USER

SHELL ["/usr/bin/zsh", "-c"]
RUN mkdir development
RUN mkdir .ssh
RUN mkdir .config

# configs
RUN git clone https://github.com/jayson-nacional/neovim-config.git .config/nvim
COPY ./mason-lsp-config.lua .config/nvim/lua/config/
COPY ./nvim-treesitter-config.lua .config/nvim/lua/config/

RUN git clone https://github.com/tmux-plugins/tpm .tmux/plugins/tpm
RUN git clone https://github.com/jayson-nacional/tmux-config.git .config/tmux
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" --unattended
RUN git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"

COPY ./.zshrc .
COPY ./.p10k.zsh .

CMD ["/bin/zsh"]
